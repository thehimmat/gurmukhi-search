# Copy to .env.local. The database is gurmukhi-kosh's self-hosted API (Postgres + PostgREST on the VM;
# Supabase was paused 2026-11-11). The anon key is public (it ships to browsers); get it from the
# gurmukhi-kosh repo's NEXT_PUBLIC_SUPABASE_ANON_KEY Actions variable, or from the server:
#   ssh ubuntu@141.148.39.45 'grep ^ANON_KEY= /opt/kosh/selfhost/.env | cut -d= -f2'

NEXT_PUBLIC_SUPABASE_URL=https://141-148-39-45.sslip.io
NEXT_PUBLIC_SUPABASE_ANON_KEY=
